# Public browser configuration only. NEVER put SUPABASE_SECRET_KEY or Firebase service-account JSON here.
REACT_APP_SUPABASE_URL=https://<project-ref>.supabase.co
REACT_APP_SUPABASE_ANON_KEY=<publishable-anon-key>

# FastAPI deployment URL. Use the origin only; /api is appended by src/lib/api.js.
REACT_APP_API_BASE_URL=http://localhost:8000

# Firebase Web App configuration (all are public client values).
REACT_APP_FIREBASE_API_KEY=<firebase-web-api-key>
REACT_APP_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=<firebase-project-id>
REACT_APP_FIREBASE_STORAGE_BUCKET=<firebase-storage-bucket>
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=<messaging-sender-id>
REACT_APP_FIREBASE_APP_ID=<firebase-app-id>
REACT_APP_FIREBASE_VAPID_KEY=<web-push-vapid-public-key>

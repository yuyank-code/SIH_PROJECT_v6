# Supabase (server only)
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."
# Required for verifying user access tokens via /auth/v1/user (see app/auth.py).
# This is the anon/publishable key -- safe to duplicate from the frontend's value.
SUPABASE_ANON_KEY="sb_publishable_..."

# Production frontend origin(s), comma-separated. Do not use * in production.
CORS_ORIGINS="https://<frontend>.onrender.com"

# Anthropic API key (Claude for risk explanations + multilingual translations).
# Optional -- if unset, the app falls back to rule-based explanations and
# offline-verified translation templates only. Get one at console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-XXXXXXXX"

# Firebase Admin service account JSON. Server-only secret; never put this in frontend env.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}'

# SMS provider (legacy fallback; push notifications use Firebase FCM HTTP v1)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# V5 model path override (optional)
# MODEL_PATH="/app/backend/ml/v5_final_model.joblib"
